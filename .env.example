# Copy this file to .env and add your actual API keys

# Get from: https://console.cloud.google.com (enable Places API)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Get from: https://console.anthropic.com (for Milestone 2)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email configuration (OPTIONAL - only needed if you want to send confirmation emails)
# For Gmail: Go to https://myaccount.google.com/apppasswords to create an app password
# NOTE: You need 2-factor authentication enabled to use app passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
